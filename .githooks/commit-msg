#!/bin/sh
# ---------------------------------------------------------------------------
# commit-msg hook: CHẶN commit có tên AI agent (message, trailer, tác giả).
#
# Bật 1 lần sau khi clone:   git config core.hooksPath .githooks
# Chạy tay để thử:           sh .githooks/commit-msg duong_dan_file_message.txt
#
# GitHub Actions (.github/workflows/ci.yml) cũng gọi script này cho mọi commit
# trong Pull Request, nên dù ai quên bật hook thì PR vẫn bị chặn.
# ---------------------------------------------------------------------------

MSG_FILE="$1"
if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
    echo "commit-msg: không tìm thấy file message" >&2
    exit 1
fi

# Tác giả/committer: CI truyền vào qua biến môi trường, chạy local thì hỏi git.
IDENT="${CHECK_IDENT:-$(git var GIT_AUTHOR_IDENT 2>/dev/null) $(git var GIT_COMMITTER_IDENT 2>/dev/null)}"

# Bỏ dòng comment (#...), bỏ phần diff sau dòng ">8" (git commit -v), về chữ thường,
# và bỏ qua tên file hợp lệ của repo (CLAUDE.md, thư mục .claude/).
TEXT=$( { sed -n '/^# -* >8 -*$/q;/^#/d;p' "$MSG_FILE"; printf '\n%s\n' "$IDENT"; } \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/claude\.md//g; s#\.claude##g' )

AGENTS='claude|anthropic|copilot|chatgpt|openai|codex|gemini|windsurf|devin|cursor-agent|aider|cline|tabnine|codeium'

fail() {
    echo "" >&2
    echo "  ✖ COMMIT BỊ CHẶN: $1" >&2
    echo "    Quy định nhóm (xem AGENTS.md): commit KHÔNG được chứa tên AI agent," >&2
    echo "    không có dòng Co-Authored-By của bot, không có 'Generated with ...'," >&2
    echo "    tác giả commit phải là tên/email Git của chính bạn." >&2
    echo "    Sửa message rồi commit lại (hoặc: git commit --amend)." >&2
    echo "" >&2
    exit 1
}

echo "$TEXT" | grep -Eq "co-authored-by:.*(${AGENTS}|\[bot\]|noreply@(anthropic|openai))" \
    && fail "có dòng Co-Authored-By của AI agent"
echo "$TEXT" | grep -Eq "generated with|generated by (an? )?ai([^a-z]|$)" \
    && fail "có dòng 'Generated with ...'"
echo "$TEXT" | grep -Eq "^[a-z-]*session: *https?://" \
    && fail "có link session của agent"
echo "$TEXT" | grep -Eq "(^|[^a-z0-9])(${AGENTS})([^a-z0-9]|$)" \
    && fail "có tên AI agent trong message hoặc trong tên/email tác giả"
grep -Fq "🤖" "$MSG_FILE" \
    && fail "có biểu tượng robot (dấu hiệu message do agent tự sinh)"

exit 0
